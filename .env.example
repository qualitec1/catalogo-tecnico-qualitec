# Copy this to .env and fill values
# Use placeholders here so you do not commit real secrets.
# Example: SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY must be kept secret and used only on the server
# Replace the value below in your local .env, but never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# App settings
NITRO_LOCALHOST=false
NODE_ENV=development
