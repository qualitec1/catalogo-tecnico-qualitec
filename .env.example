# ⚠️ IMPORTANTE: NUNCA COMMITE O ARQUIVO .env COM CREDENCIAIS REAIS!
# Este é apenas um exemplo. Copie para .env e preencha com suas credenciais.

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_KEY=your-anon-key-here
# ⚠️ SERVICE_ROLE_KEY deve ser mantido SECRETO e usado APENAS no servidor
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# App Settings
NITRO_LOCALHOST=false
NODE_ENV=development

# Cloudflare R2 Configuration
# ⚠️ Estas credenciais dão acesso total ao seu storage
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-your-public-id.r2.dev

# Como obter suas credenciais:
# 
# SUPABASE:
# 1. Acesse https://supabase.com/dashboard
# 2. Selecione seu projeto
# 3. Vá em Settings > API
# 4. Copie as chaves necessárias
#
# CLOUDFLARE R2:
# 1. Acesse https://dash.cloudflare.com
# 2. Vá em R2 > Manage R2 API Tokens
# 3. Crie um novo token com permissões adequadas
# 4. Copie as credenciais geradas
